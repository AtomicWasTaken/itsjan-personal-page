---
import type { HTMLAttributes } from "astro/types";
import Tooltip from "./Tooltip.astro";

type LinkVariant = "plain" | "primary" | "text" | "icon";

interface Props extends Omit<HTMLAttributes<"a">, "class"> {
  href: string;
  class?: string;
  variant?: LinkVariant;
  wrapperClass?: string;
  tooltipId?: string;
  tooltipTitle?: string;
  tooltipDetail?: string;
  tooltipClass?: string;
  cuelumeHover?: string;
  cuelumePress?: string;
  cuelumeRelease?: string;
}

const {
  class: className,
  variant = "plain",
  wrapperClass,
  tooltipId,
  tooltipTitle,
  tooltipDetail,
  tooltipClass,
  cuelumeHover = "tick",
  cuelumePress = "press",
  cuelumeRelease = "release",
  target,
  rel,
  ...attributes
} = Astro.props;
const hasTooltip = Boolean(tooltipId && (tooltipTitle || tooltipDetail));
const variantClass =
  variant === "primary"
    ? "button-style squircle"
    : variant === "text"
      ? "text-action"
      : variant === "icon"
        ? "squircle"
        : "";
const linkClass = [variantClass, className, hasTooltip && "t-tt-trigger"]
  .filter(Boolean)
  .join(" ");
const linkRel =
  target === "_blank"
    ? [...new Set(`${rel ?? ""} noopener noreferrer`.trim().split(/\s+/))].join(
        " ",
      )
    : rel;
---

{
  hasTooltip ? (
    <Tooltip
      id={tooltipId!}
      title={tooltipTitle}
      detail={tooltipDetail}
      class={tooltipClass}
      wrapperClass={wrapperClass}
    >
      <a
        slot="trigger"
        {...attributes}
        target={target}
        rel={linkRel}
        class={linkClass}
        aria-describedby={tooltipId}
        data-cuelume-hover={cuelumeHover}
        data-cuelume-press={cuelumePress}
        data-cuelume-release={cuelumeRelease}
      >
        <slot />
      </a>
    </Tooltip>
  ) : (
    <a
      {...attributes}
      target={target}
      rel={linkRel}
      class={linkClass}
      data-cuelume-hover={cuelumeHover}
      data-cuelume-press={cuelumePress}
      data-cuelume-release={cuelumeRelease}
    >
      <slot />
    </a>
  )
}
