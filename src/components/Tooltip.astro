---
interface Props {
  id: string;
  title?: string;
  detail?: string;
  text?: string;
  class?: string;
  wrapperClass?: string;
}

const {
  id,
  title,
  detail,
  text,
  class: className,
  wrapperClass,
} = Astro.props;
---

<span class:list={["t-tt-wrap", wrapperClass]}>
  <slot name="trigger" />
  <span id={id} class:list={["t-tt", className]} role="tooltip">
    {title && <strong class="t-tt__title">{title}</strong>}
    {detail && <span class="t-tt__detail">{detail}</span>}
    {text && <span class="t-tt__text">{text}</span>}
  </span>
</span>
