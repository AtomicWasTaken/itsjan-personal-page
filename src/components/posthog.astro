---
import { env } from "cloudflare:workers";

const analyticsEnabled =
  !import.meta.env.DEV ||
  import.meta.env.PUBLIC_POSTHOG_ENABLE_IN_DEV === "true";
const apiKey = analyticsEnabled
  ? (env.PUBLIC_POSTHOG_PROJECT_TOKEN ??
    import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN)
  : undefined;
const apiHost = analyticsEnabled
  ? (env.PUBLIC_POSTHOG_HOST ?? import.meta.env.PUBLIC_POSTHOG_HOST)
  : undefined;
const uiHost = analyticsEnabled
  ? (env.PUBLIC_POSTHOG_UI_HOST ?? import.meta.env.PUBLIC_POSTHOG_UI_HOST)
  : undefined;
---

<meta name="posthog-api-key" content={apiKey} />
<meta name="posthog-api-host" content={apiHost} />
<meta name="posthog-ui-host" content={uiHost} />

<script>
  const readSetting = (name: string): string | undefined => {
    const value = document
      .querySelector<HTMLMetaElement>(`meta[name="${name}"]`)
      ?.content.trim();
    return value || undefined;
  };

  const apiKey = readSetting("posthog-api-key");
  const apiHost = readSetting("posthog-api-host");
  const uiHost = readSetting("posthog-ui-host");
  const consentKey = "itsjan-analytics-consent";
  let analytics: Window["posthog"];
  let loadPromise: Promise<void> | undefined;
  let consentGranted = false;

  try {
    consentGranted = window.localStorage.getItem(consentKey) === "granted";
  } catch {
    // Consent can still be granted for this page when storage is unavailable.
  }

  const startPostHog = (): void => {
    if (analytics) {
      analytics.opt_in_capturing();
      return;
    }
    if (loadPromise || !apiKey || !apiHost) return;

    loadPromise = Promise.all([
      import("posthog-js/dist/module.no-external"),
      import("posthog-js/dist/exception-autocapture"),
    ])
      .then(([{ default: posthog }]) => {
        if (!consentGranted) {
          loadPromise = undefined;
          return;
        }

        analytics = posthog;
        window.posthog = posthog;
        posthog.init(apiKey, {
          api_host: apiHost,
          ui_host: uiHost,
          defaults: "2026-05-30",
          person_profiles: "identified_only",
          advanced_disable_flags: true,
          disable_external_dependency_loading: true,
          disable_session_recording: true,
          capture_exceptions: {
            capture_unhandled_errors: true,
            capture_unhandled_rejections: true,
            capture_console_errors: false,
          },
          tracing_headers: [window.location.hostname],
        });
      })
      .catch(() => {
        loadPromise = undefined;
      });
  };

  if (consentGranted) startPostHog();

  window.addEventListener("itsjan:analytics-consent", (event) => {
    if (!(event instanceof CustomEvent)) return;
    consentGranted = event.detail === "granted";
    if (consentGranted) {
      startPostHog();
      return;
    }
    analytics?.opt_out_capturing({ clear_persistence: true });
  });
</script>
