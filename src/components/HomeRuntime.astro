<script>
  import { initializeHomeRuntime } from "../scripts/home";

  declare global {
    interface Window {
      cleanupHomeRuntime?: () => void;
    }
  }

  window.cleanupHomeRuntime?.();
  window.cleanupHomeRuntime = initializeHomeRuntime();
  document.addEventListener(
    "astro:before-swap",
    () => window.cleanupHomeRuntime?.(),
    { once: true },
  );
</script>
