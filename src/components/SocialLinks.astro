---
import { Image } from "astro:assets";
import type { ActivityDay } from "../lib/github";
import {
  CONTACT_MAILTO,
  PERSON_NAME,
  SITE_ORIGIN,
  SOCIAL_HANDLES,
  SOCIAL_LINKS,
} from "../lib/site";
import profile160 from "../assets/jan-profile-160.avif";
import linkedinBanner from "../assets/social/linkedin-banner.png";
import xBanner from "../assets/social/x-banner.jpg";
import GitHubIcon from "./icons/GitHubIcon.astro";
import InteractiveButton from "./InteractiveButton.astro";
import InteractiveLink from "./InteractiveLink.astro";

interface Props {
  locale: "de" | "en";
  linkedinUrl: string;
  activity: ActivityDay[];
  labels: {
    xAria: string;
    githubAria: string;
    linkedinAria: string;
    emailAria: string;
    shareAria: string;
    shareTooltip: string;
    linkCopied: string;
  };
}

const { locale, linkedinUrl, activity, labels } = Astro.props;
const isGerman = locale === "de";
const githubActivity = activity.slice(-364);
const contributionTotal = githubActivity.reduce(
  (total, day) => total + day.count,
  0,
);
const contributionLabel = isGerman
  ? `${new Intl.NumberFormat("de-DE").format(contributionTotal)} Beiträge im letzten Jahr`
  : `${new Intl.NumberFormat("en-US").format(contributionTotal)} contributions in the last year`;
---

<div
  class="social-links social-preview-group flex items-center text-[var(--text-tertiary)]"
  data-social-preview-root
>
  <div class="social-preview" data-social-preview aria-hidden="true" inert>
    <div class="social-preview__viewport" data-social-preview-viewport>
      <article
        class="social-preview__panel social-preview__panel--github"
        data-social-panel="github"
      >
        <div class="social-card-github">
          <div class="social-card-profile">
            <div>
              <Image
                src={profile160}
                alt=""
                width={80}
                height={80}
                class="social-card-avatar social-card-avatar--round"
              />
            </div>
            <div class="social-card-profile-copy">
              <strong>{PERSON_NAME}</strong>
              <span>@{SOCIAL_HANDLES.github}</span>
            </div>
            <InteractiveLink
              class="social-card-github-action"
              href={SOCIAL_LINKS.github}
              target="_blank"
              rel="noreferrer"
              >{isGerman ? "GitHub öffnen" : "Open GitHub"}</InteractiveLink
            >
          </div>
          <p class="social-card-github-bio">
            Coding Enthusiast Living in Germany
          </p>
          <div class="social-card-github-meta">
            <span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"
                ></path><circle cx="12" cy="10" r="2.5"></circle></svg
              >
              {isGerman ? "Deutschland" : "Germany"}
            </span>
            <InteractiveLink
              class="social-card-github-site"
              href={SITE_ORIGIN}
              target="_blank"
              rel="noreferrer">itsjan.dev</InteractiveLink
            >
          </div>
          <span class="social-card-github-contribution-label"
            >{contributionLabel}</span
          >
          <div class="social-card-contributions" aria-hidden="true">
            {githubActivity.map((day) => <i data-level={day.level} />)}
          </div>
        </div>
      </article>

      <article
        class="social-preview__panel social-preview__panel--linkedin"
        data-social-panel="linkedin"
      >
        <Image
          class="social-card-linkedin-banner"
          src={linkedinBanner}
          alt=""
          width="1584"
          height="396"
        />
        <div class="social-card-floating-avatar">
          <Image
            src={profile160}
            alt=""
            width={112}
            height={112}
            class="social-card-avatar social-card-avatar--round"
          />
        </div>
        <div class="social-card-linkedin-body">
          <div class="social-card-name">
            <strong>{PERSON_NAME}</strong>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path
                d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.96 11.96 0 0 1 3.598 6 12 12 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285"
              ></path></svg
            >
          </div>
          <div class="social-card-linkedin-footer">
            <p>
              {
                isGerman
                  ? "Schwanewede, Niedersachsen, Deutschland"
                  : "Schwanewede, Lower Saxony, Germany"
              }
            </p>
            <InteractiveLink
              class="social-card-linkedin-action"
              href={linkedinUrl}
              target="_blank"
              rel="noreferrer"
              >{isGerman ? "Vernetzen" : "Connect"}</InteractiveLink
            >
          </div>
        </div>
      </article>

      <article
        class="social-preview__panel social-preview__panel--x"
        data-social-panel="x"
      >
        <Image
          class="social-card-x-banner"
          src={xBanner}
          alt=""
          width="1500"
          height="500"
        />
        <div class="social-card-floating-avatar social-card-floating-avatar--x">
          <Image
            src={profile160}
            alt=""
            width={112}
            height={112}
            class="social-card-avatar social-card-avatar--round"
          />
        </div>
        <div class="social-card-x-body">
          <div class="social-card-x-row">
            <div class="social-card-x-handle">
              <strong>@{SOCIAL_HANDLES.x}</strong>
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
                ><path
                  fill-rule="evenodd"
                  d="M15 8c0 .982-.472 1.854-1.202 2.402a3 3 0 0 1-.848 2.547 3 3 0 0 1-2.548.849A3 3 0 0 1 8 15a3 3 0 0 1-2.402-1.202 3 3 0 0 1-2.547-.848 3 3 0 0 1-.849-2.548A3 3 0 0 1 1 8c0-.982.472-1.854 1.202-2.402a3 3 0 0 1 .848-2.547 3 3 0 0 1 2.548-.849A3 3 0 0 1 8 1c.982 0 1.854.472 2.402 1.202a3 3 0 0 1 2.547.848c.695.695.978 1.645.849 2.548A3 3 0 0 1 15 8m-3.291-2.843a.75.75 0 0 1 .135 1.052l-4.25 5.5a.75.75 0 0 1-1.151.043l-2.25-2.5a.75.75 0 1 1 1.114-1.004l1.65 1.832 3.7-4.789a.75.75 0 0 1 1.052-.134"
                  clip-rule="evenodd"></path></svg
              >
            </div>
            <InteractiveLink
              class="social-card-x-action"
              href={SOCIAL_LINKS.x}
              target="_blank"
              rel="noreferrer">{isGerman ? "Folgen" : "Follow"}</InteractiveLink
            >
          </div>
          <span class="social-card-x-bio"
            >Software Developer. Founder @fnnyapp.</span
          >
        </div>
      </article>
    </div>
  </div>

  <InteractiveLink
    variant="icon"
    href={SOCIAL_LINKS.github}
    target="_blank"
    rel="noreferrer"
    aria-label={labels.githubAria}
    class="social-link"
    data-social-preview-key="github"
    data-analytics-event="social_link_clicked"
    data-analytics-platform="github"><GitHubIcon /></InteractiveLink
  >
  <InteractiveLink
    variant="icon"
    href={linkedinUrl}
    target="_blank"
    rel="noreferrer"
    aria-label={labels.linkedinAria}
    class="social-link"
    data-social-preview-key="linkedin"
    data-analytics-event="social_link_clicked"
    data-analytics-platform="linkedin"
    ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
      ><path
        d="M5 4.5A1.5 1.5 0 1 1 2 4.5a1.5 1.5 0 0 1 3 0ZM2.5 8.5h3V21h-3V8.5ZM9 8.5h2.9v1.7h.1c.4-.8 1.5-2.1 3.6-2.1 3.9 0 4.6 2.6 4.6 6V21h-3v-6.1c0-1.5 0-3.5-2.1-3.5s-2.4 1.7-2.4 3.4V21H9V8.5Z"
      ></path></svg
    ></InteractiveLink
  >
  <InteractiveLink
    variant="icon"
    href={SOCIAL_LINKS.x}
    target="_blank"
    rel="noreferrer"
    aria-label={labels.xAria}
    class="social-link"
    data-social-preview-key="x"
    data-analytics-event="social_link_clicked"
    data-analytics-platform="x"
    ><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
      ><path
        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
      ></path></svg
    ></InteractiveLink
  >
  <InteractiveLink
    variant="icon"
    href={CONTACT_MAILTO}
    aria-label={labels.emailAria}
    class="social-link"
    data-social-preview-close
    data-analytics-event="social_link_clicked"
    data-analytics-platform="email"
    wrapperClass="social-tooltip-wrap"
    tooltipId="social-tooltip-email"
    tooltipTitle="hi@itsjan.dev"
    tooltipClass="social-tooltip"
    ><svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><rect x="2.5" y="4.5" width="19" height="15" rx="3"></rect><path
        d="m3 6 9 6 9-6"></path></svg
    ></InteractiveLink
  >
  <InteractiveButton
    variant="icon"
    id="share-profile"
    aria-label={labels.shareAria}
    data-label-copied={labels.linkCopied}
    data-social-preview-close
    data-analytics-event="social_link_clicked"
    data-analytics-platform="share"
    class="social-link social-share"
    wrapperClass="social-tooltip-wrap"
    tooltipId="social-tooltip-share"
    tooltipTitle={labels.shareTooltip}
    tooltipClass="social-tooltip"
    ><svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      ><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"
      ></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 10.5 6.8-4"
      ></path><path d="m8.6 13.5 6.8 4"></path></svg
    ></InteractiveButton
  >
  <div class="social-preview__hover-bridge" aria-hidden="true"></div>
</div>

<script>
  import { initializeSocialPreviews } from "../scripts/social-preview";

  const cleanup = initializeSocialPreviews();
  document.addEventListener("astro:before-swap", cleanup, { once: true });
</script>
