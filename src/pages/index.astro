---
import Layout from "../layouts/Layout.astro";
import { detectLocale, tr } from "../lib/i18n";
import { ageYears } from "../lib/jan";

const locale = detectLocale(Astro.request);
const copy = tr(locale).portfolio;
const currentAge = ageYears();
const experienceOnlyTechnologies = [
  {
    name: "Symfony",
    logo: "https://cdn.simpleicons.org/symfony/000000",
    href: "https://symfony.com/",
    darkModeLight: true,
    detail: { en: "Backend framework used during my apprenticeship.", de: "Backend-Framework aus meiner Ausbildung." },
  },
  {
    name: "Git",
    logo: "https://cdn.simpleicons.org/git/F05032",
    href: "https://git-scm.com/",
    detail: { en: "Version control used during my apprenticeship.", de: "Versionsverwaltung aus meiner Ausbildung." },
  },
];
const experienceTechnologyItems = [...copy.tech.items, ...experienceOnlyTechnologies];
const technologyByName = new Map(experienceTechnologyItems.map((technology) => [technology.name, technology]));
const featuredMobileTechnologyNames = ["PHP", "TypeScript", "React", "Next.js", "TYPO3", "Symfony", "Git", "Docker"];
const mobileTechnologies = featuredMobileTechnologyNames
  .map((name) => technologyByName.get(name))
  .filter((technology): technology is (typeof experienceTechnologyItems)[number] => Boolean(technology));
const mobileAdditionalTechnologies = experienceTechnologyItems.filter((technology) => !featuredMobileTechnologyNames.includes(technology.name));
const technologiesFor = (names: string[]) => names
  .map((name) => technologyByName.get(name))
  .filter((technology): technology is (typeof experienceTechnologyItems)[number] => Boolean(technology));

type GithubDay = { date: string; level: number; count: number };

const parseGithubContributions = (html: string): GithubDay[] => {
  const days: GithubDay[] = [];
  const cellPattern = /<td\b([^>]*)><\/td>/gi;
  let cell: RegExpExecArray | null;

  while ((cell = cellPattern.exec(html))) {
    const attributes = cell[1];
    if (!/\bContributionCalendar-day\b/i.test(attributes)) continue;

    const date = attributes.match(/\bdata-date="([^"]+)"/i)?.[1];
    if (!date) continue;

    const level = Number(attributes.match(/\bdata-level="(\d+)"/i)?.[1] ?? 0);
    const tooltip = html
      .slice(cell.index + cell[0].length, cell.index + cell[0].length + 600)
      .match(/<tool-tip\b[^>]*>([\s\S]*?)<\/tool-tip>/i)?.[1]
      ?.replace(/<[^>]+>/g, "")
      .trim();
    const count = Number(tooltip?.match(/\b(\d+)\s+contributions?\b/i)?.[1] ?? 0);

    days.push({ date, level: Math.min(4, Math.max(0, level)), count });
  }

  return days.sort((a, b) => a.date.localeCompare(b.date));
};

const fetchGithubContributions = async (): Promise<GithubDay[]> => {
  try {
    const response = await fetch("https://github.com/users/AtomicWasTaken/contributions", {
      headers: {
        accept: "text/html",
        "user-agent": "itsjan.dev contribution graph",
      },
      signal: AbortSignal.timeout(5000),
    });
    if (!response.ok) return [];

    const days = parseGithubContributions(await response.text());
    return days.length > 0 ? days : [];
  } catch {
    return [];
  }
};

// This runs on every SSR request so the graph always reflects GitHub's latest public data.
const githubDays = await fetchGithubContributions();
const today = new Date();
today.setUTCHours(12, 0, 0, 0);
const dateKey = (date: Date) => date.toISOString().slice(0, 10);
const formatter = new Intl.DateTimeFormat(locale, { day: "numeric", month: "long", year: "numeric" });
const githubByDate = new Map(githubDays.map((day) => [day.date, day]));
const activityStart = githubDays.length
  ? new Date(`${githubDays[0].date}T12:00:00Z`)
  : new Date(today);

if (!githubDays.length) activityStart.setUTCDate(today.getUTCDate() - 364);

const activityLength = githubDays.length || 365;
const activity = Array.from({ length: activityLength }, (_, index) => {
  const date = new Date(activityStart);
  date.setUTCDate(activityStart.getUTCDate() + index);
  const contribution = githubByDate.get(dateKey(date));
  const count = contribution?.count ?? 0;
  const level = contribution?.level ?? 0;

  return {
    label: `${formatter.format(date)} · ${count} ${count === 1 ? copy.activity.contribution : copy.activity.contributions}`,
    level,
    project: count ? "other" : "none",
    count,
  };
});
const mobileActivity = activity;
const activityColumns = Math.ceil(activity.length / 7);
const mobileActivityColumns = activityColumns;
// The DOM is column-major, matching the visual grid. Give every tile in a
// column the same delay so all seven rows advance in parallel, left → right.
const activityRevealOrder = (index: number, _columns: number) => Math.floor(index / 7);
type StickerPlacement = { side: "left" | "right"; topPercent: number; offsetPercent: number; size: number; rotation: number };
const randomInt = (min: number, max: number) => Math.floor(Math.random() * (max - min + 1)) + min;
const randomInBand = (index: number, count: number, start: number, end: number) => {
  if (count <= 1) return (start + end) / 2;
  const bandSize = (end - start) / count;
  const bandStart = start + index * bandSize;
  const inset = bandSize * 0.2;
  return bandStart + inset + Math.random() * (bandSize - inset * 2);
};
const shuffle = <T>(items: T[]) => {
  for (let index = items.length - 1; index > 0; index -= 1) {
    const swapIndex = randomInt(0, index);
    [items[index], items[swapIndex]] = [items[swapIndex], items[index]];
  }
  return items;
};
const createStickerLayout = (count: number): StickerPlacement[] => {
  const rowCount = Math.ceil(count / 2);
  const pairCount = Math.floor(count / 2);
  const topPositions = Array.from({ length: rowCount }, (_, row) => randomInBand(row, rowCount, 5, 94));
  const pairOffsets = shuffle(Array.from({ length: pairCount }, (_, column) => randomInBand(column, pairCount, 5, 100)));
  const rows = Array.from({ length: rowCount }, (_, row) => {
    // One random point per horizontal and vertical band keeps the composition
    // loose without allowing clusters or large unused areas.
    const topPercent = topPositions[row];
    const offsetPercent = row < pairCount ? pairOffsets[row] : randomInt(20, 80);
    const size = randomInt(32, 43);
    const tilt = randomInt(4, 12) * (Math.random() < 0.5 ? -1 : 1);

    if (row < pairCount) {
      const left = { side: "left" as const, topPercent, offsetPercent, size, rotation: tilt };
      const right = { side: "right" as const, topPercent, offsetPercent, size, rotation: -tilt };
      return Math.random() < 0.5 ? [left, right] : [right, left];
    }

    // With an odd number of logos, keep the final one at the edge of a row;
    // every other row remains a mirrored pair.
    return [{
      side: Math.random() < 0.5 ? "left" as const : "right" as const,
      topPercent,
      offsetPercent,
      size,
      rotation: randomInt(-12, 12),
    }];
  });

  return shuffle(rows).flat().slice(0, count);
};
const stickerLayout = createStickerLayout(copy.tech.items.length);
if (stickerLayout[0]) stickerLayout[0].side = "left";
const stickerStyle = (index: number) => {
  const placement = stickerLayout[index];
  if (index === 0) {
    return `top:clamp(48px,14vh,112px); --sticker-x:48px; --icon-size:${placement.size}px; --sticker-rotation:${placement.rotation}deg`;
  }
  return `top:${placement.topPercent}%; --sticker-x:${placement.offsetPercent}%; --icon-size:${placement.size}px; --sticker-rotation:${placement.rotation}deg`;
};
---

<Layout>
<div class="portfolio-shell">
  <div class="top-edge-blur" aria-hidden="true">
    <div class="top-edge-blur__wash"></div>
    <div class="top-edge-blur__layer top-edge-blur__layer--1"></div>
    <div class="top-edge-blur__layer top-edge-blur__layer--2"></div>
    <div class="top-edge-blur__layer top-edge-blur__layer--3"></div>
    <div class="top-edge-blur__layer top-edge-blur__layer--4"></div>
  </div>
  <aside class="tech-stickers" aria-label={copy.tech.aria} data-hover-hint={copy.tech.hoverHint}>
    <div class="tech-sticker-side tech-sticker-side--left">
      {copy.tech.items.map((technology, index) => {
        const placement = stickerLayout[index];
        return placement.side === "left" && (
          <a
            href={technology.href}
            target="_blank"
            rel="noreferrer"
            class={`t-tt-wrap t-tt-trigger tech-sticker tech-sticker--left tech-sticker-${index + 1}${technology.darkModeLight ? " tech-sticker--dark-logo" : ""}`}
            style={stickerStyle(index)}
            aria-label={technology.name}
            aria-describedby={`tech-tooltip-${index}`}
            tabindex="0"
          >
            <img src={technology.logo} alt="" width="28" height="28" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" />
            <span id={`tech-tooltip-${index}`} class="t-tt tech-tool-card" role="tooltip">
              <span class="tech-tool-card__surface">
                <span class="tech-tool-card__head">
                  <span class="tech-tool-card__logo"><img src={technology.logo} alt="" width="20" height="20" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" /></span>
                  <span class="tech-tool-card__title"><strong>{technology.name}</strong><small>{copy.tech.cardLabel}</small></span>
                </span>
                <span class="tech-tool-card__body">{technology.detail[locale]}</span>
                <span class="tech-tool-card__footer"><span class="tech-tool-card__action">{copy.tech.visitLabel(technology.name)}</span></span>
              </span>
            </span>
          </a>
        );
      })}
    </div>
    <div class="tech-sticker-side tech-sticker-side--right">
      {copy.tech.items.map((technology, index) => {
        const placement = stickerLayout[index];
        return placement.side === "right" && (
          <a
            href={technology.href}
            target="_blank"
            rel="noreferrer"
            class={`t-tt-wrap t-tt-trigger tech-sticker tech-sticker--right tech-sticker-${index + 1}${technology.darkModeLight ? " tech-sticker--dark-logo" : ""}`}
            style={stickerStyle(index)}
            aria-label={technology.name}
            aria-describedby={`tech-tooltip-${index}`}
            tabindex="0"
          >
            <img src={technology.logo} alt="" width="28" height="28" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" />
            <span id={`tech-tooltip-${index}`} class="t-tt tech-tool-card" role="tooltip">
              <span class="tech-tool-card__surface">
                <span class="tech-tool-card__head">
                  <span class="tech-tool-card__logo"><img src={technology.logo} alt="" width="20" height="20" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" /></span>
                  <span class="tech-tool-card__title"><strong>{technology.name}</strong><small>{copy.tech.cardLabel}</small></span>
                </span>
                <span class="tech-tool-card__body">{technology.detail[locale]}</span>
                <span class="tech-tool-card__footer"><span class="tech-tool-card__action">{copy.tech.visitLabel(technology.name)}</span></span>
              </span>
            </span>
          </a>
        );
      })}
    </div>
  </aside>
  <div id="avatar-modal" class="t-modal avatar-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-label={copy.avatar.expand}>
    <button type="button" class="avatar-modal-backdrop" data-avatar-close data-cuelume-toggle="release" aria-label={copy.avatar.collapse}></button>
    <div class="avatar-modal-content">
      <button type="button" class="squircle avatar-modal-close" data-avatar-close data-cuelume-toggle="release" aria-label={copy.avatar.collapse}>
        <span aria-hidden="true">×</span>
      </button>
      <img src="/jan-profile.jpg" alt="Jan-Marlon Leibl" width="320" height="320" class="avatar-modal-image" />
    </div>
  </div>
<main class="portfolio-main mx-auto max-w-2xl space-y-12 pt-36 pb-12 md:space-y-14 md:pb-16">
  <section>
    <div class="profile-row">
      <button
        id="profile-avatar"
        class="profile-avatar"
        type="button"
        data-cuelume-hover="whisper"
        data-cuelume-press="press"
        aria-label={copy.avatar.expand}
        aria-haspopup="dialog"
        aria-controls="avatar-modal"
      >
        <img src="/jan-profile.jpg" alt="Jan-Marlon Leibl" width="160" height="160" class="profile-image" />
      </button>
      <button
        id="theme-toggle"
        class="squircle theme-toggle"
        type="button"
        data-cuelume-toggle="toggle"
        aria-label={copy.theme.label}
        aria-pressed="false"
        data-label-dark={copy.theme.toDark}
        data-label-light={copy.theme.toLight}
      >
        <span class="theme-icon theme-icon--sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path></svg>
        </span>
        <span class="theme-icon theme-icon--moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M20 15.2A8.3 8.3 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"></path></svg>
        </span>
      </button>
    </div>
    <h1 class="text-2xl font-medium tracking-tight">Jan-Marlon Leibl</h1>
    <p class="profile-subtitle mt-1" data-text-states={JSON.stringify(copy.subtitleStates(currentAge))}>
      <span class="t-text-swap">{copy.subtitle(currentAge)}</span>
    </p>
    <p class="mt-4 max-w-lg text-[17px] font-normal leading-7 text-[var(--text-secondary)]">
      {copy.intro.beforeBremen}<span class="keyword">Bremen</span>{copy.intro.afterBremen}<span class="keyword">{copy.intro.apprenticeship}</span>{copy.intro.afterApprenticeship}<span class="keyword">{copy.intro.finny}</span>{copy.intro.afterFinny}
    </p>
  </section>
  <hr class="wave" aria-hidden="true" />

  <section>
    <h2 class="text-2xl font-medium tracking-tight text-[var(--text)]">{copy.experience.heading}</h2>
    <ol class="experience-list mt-6">
      {copy.experience.items.map((item) => (
        <li class="experience-item">
          <p class="experience-period">{item.period}<span aria-hidden="true">, </span>{item.location}</p>
          <h3>
            {item.title}
            <span class="experience-organization">
              {item.organization}
            </span>
          </h3>
          {item.secondary && (
            <div class="experience-secondary">
              <div class="experience-role-branch border-border absolute left-2 h-7 w-4.5 rounded-bl-lg border-b-2 border-l-2" aria-hidden="true"></div>
              <p>{item.secondary.period}</p>
              <strong>{item.secondary.title}</strong>
            </div>
          )}
          <ul class="experience-bullets">
            {item.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
          <ul class="experience-technologies" aria-label={copy.tech.aria}>
            {technologiesFor(item.technologies).map((technology) => (
              <li>
                <a
                  class={technology.darkModeLight ? "squircle experience-technology experience-technology--dark-logo" : "squircle experience-technology"}
                  href={technology.href}
                  target="_blank"
                  rel="noreferrer"
                  data-cuelume-hover="tick"
                  data-cuelume-press="press"
                  data-cuelume-release="release"
                >
                  <img src={technology.logo} alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" />
                  <span>{technology.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>
  <hr class="wave" aria-hidden="true" />

  <section>
    <h2 class="text-2xl font-medium tracking-tight text-[var(--text)]">{copy.projects}</h2>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <article class="project-preview w-full overflow-visible">
        <div class="project-preview-surface">
          <div class="project-preview-image project-preview-image--finny" role="img" aria-label={copy.finny.previewAria}>
            <span class="preview-brand"><img src="/finny-favicon.png" alt="" width="28" height="28" />finny</span>
            <span class="preview-receipt preview-receipt--one" aria-hidden="true"><b>{copy.finny.receiptTitle}</b><i>{copy.finny.receiptVendor}</i><i>{copy.finny.receiptDetail}</i></span>
            <span class="preview-receipt preview-receipt--two" aria-hidden="true"><b>{copy.finny.warrantyTitle}</b><i>{copy.finny.warrantyDetail}</i><small>{copy.finny.warrantyUntil}</small></span>
          </div>
          <div class="project-preview-copy p-4">
            <p class="text-[15px] font-normal leading-6 text-[var(--text-secondary)]">
              {copy.finny.description.lead}<span class="keyword">{copy.finny.description.first}</span>{copy.finny.description.middle}<span class="keyword">{copy.finny.description.second}</span>{copy.finny.description.join}<span class="keyword">{copy.finny.description.third}</span>{copy.finny.description.end}
            </p>
            <div class="project-preview-action"><a href="https://fnny.app" target="_blank" rel="noreferrer" class="button-style squircle project-preview-cta" data-cuelume-hover="tick" data-cuelume-press="press" data-cuelume-release="release">{copy.finny.cta.label}</a></div>
          </div>
        </div>
      </article>

      <article class="project-preview w-full overflow-visible">
        <div class="project-preview-surface">
          <div class="project-preview-image project-preview-image--ventry" role="img" aria-label={copy.ventry.previewAria}>
            <span class="preview-brand preview-brand--ventry">
              <img class="ventry-mark" src="https://ventry.host/ventry-logo-white.png" alt="" width="28" height="28" loading="lazy" />
              ventry.host
            </span>
            <span class="ventry-file-panel" aria-hidden="true">
              <span class="ventry-file-panel-head"><b>{copy.ventry.panelTitle}</b><i>{copy.ventry.panelCount}</i></span>
              <span class="ventry-file-row">
                <span class="ventry-file-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M6 4.5h8l4 4v11H6v-15Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M14 4.5v4h4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg></span>
                <span><b>portrait.jpg</b><small>{copy.ventry.fileStatus}</small></span>
                <i>2.4 MB</i>
              </span>
              <span class="ventry-file-row ventry-file-row--muted">
                <span class="ventry-file-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M8 12h8m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <span><b>{copy.ventry.shareLabel}</b><small>{copy.ventry.shareStatus}</small></span>
                <i>{copy.ventry.shareAction}</i>
              </span>
            </span>
          </div>
          <div class="project-preview-copy p-4">
            <p class="text-[15px] font-normal leading-6 text-[var(--text-secondary)]">
              {copy.ventry.description.lead}<span class="keyword">{copy.ventry.description.keyword}</span>{copy.ventry.description.end}
            </p>
            <div class="project-preview-action"><a href="https://ventry.host" target="_blank" rel="noreferrer" class="button-style squircle project-preview-cta" data-cuelume-hover="tick" data-cuelume-press="press" data-cuelume-release="release">{copy.ventry.cta.label}</a></div>
          </div>
        </div>
      </article>

    </div>
  </section>
  <hr class="wave" aria-hidden="true" />

  <section class="mobile-tech-section">
    <h2 class="text-2xl font-medium tracking-tight text-[var(--text)]">{copy.tech.mobileHeading}</h2>
    <div id="mobile-tech-accordion" class="t-acc mobile-tech-accordion" data-open="false">
      <ul id="mobile-tech-list" class="mobile-tech-grid mt-6" aria-label={copy.tech.aria}>
        {mobileTechnologies.map((technology) => (
          <li>
            <a
              class={`mobile-tech-link${technology.darkModeLight ? " mobile-tech-link--dark-logo" : ""}`}
              href={technology.href}
              target="_blank"
              rel="noreferrer"
              aria-label={copy.tech.visitLabel(technology.name)}
              data-cuelume-hover="tick"
              data-cuelume-press="press"
              data-cuelume-release="release"
            >
              <img src={technology.logo} alt="" width="28" height="28" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" />
              <span>{technology.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <div id="mobile-tech-additional" class="t-acc-panel">
        <div class="t-acc-panel-inner">
          <ul class="mobile-tech-grid" aria-label={copy.tech.aria}>
            {mobileAdditionalTechnologies.map((technology) => (
              <li>
                <a
                  class={`mobile-tech-link${technology.darkModeLight ? " mobile-tech-link--dark-logo" : ""}`}
                  href={technology.href}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={copy.tech.visitLabel(technology.name)}
                  data-cuelume-hover="tick"
                  data-cuelume-press="press"
                  data-cuelume-release="release"
                >
                  <img src={technology.logo} alt="" width="28" height="28" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" />
                  <span>{technology.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <button
        id="mobile-tech-toggle"
        class="button-style squircle t-acc-head mobile-tech-toggle"
        type="button"
        aria-controls="mobile-tech-additional"
        aria-expanded="false"
        data-label-more={copy.tech.mobileViewMore}
        data-label-less={copy.tech.mobileViewLess}
        data-cuelume-hover="tick"
        data-cuelume-press="press"
        data-cuelume-release="release"
      >
        <span class="mobile-tech-toggle-label">{copy.tech.mobileViewMore}</span>
        <span class="t-acc-chevron" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M4 6.5L8 10.5L12 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
      </button>
    </div>
  </section>
  <hr class="wave wave--mobile" aria-hidden="true" />

  <section>
    <h2 class="text-2xl font-medium tracking-tight text-[var(--text)]">{copy.activity.heading}</h2>
    <div class="mt-6">
      <div class="activity-scroll activity-scroll-desktop" aria-label={copy.activity.desktopAria}>
        <div class="t-skel activity-reveal" data-state="loading">
          <div class="t-skel-skeleton is-pulsing activity-grid" aria-hidden="true">
            {activity.map((_, index) => <span class="activity-day" data-level="0" style={`--activity-order:${activityRevealOrder(index, activityColumns)}`}></span>)}
          </div>
          <div class="t-skel-content activity-grid">
            {activity.map((day, index) => (
              day.count > 0 ? (
                <span class="t-tt-wrap activity-tooltip-wrap">
                  <span class="activity-day t-tt-trigger" data-cuelume-hover="tick" data-level={day.level} data-project={day.project} aria-label={day.label} aria-describedby={`activity-tooltip-desktop-${index}`} tabindex="0" style={`--activity-order:${activityRevealOrder(index, activityColumns)}`}></span>
                  <span id={`activity-tooltip-desktop-${index}`} class="t-tt activity-tooltip" role="tooltip">{day.label}</span>
                </span>
              ) : (
                <span class="activity-day" data-level={day.level} data-project={day.project} aria-label={day.label} style={`--activity-order:${activityRevealOrder(index, activityColumns)}`}></span>
              )
            ))}
          </div>
        </div>
      </div>
