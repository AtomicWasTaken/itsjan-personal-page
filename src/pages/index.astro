    sticker.dataset.cuelumeRelease = "release";
    sticker.addEventListener("tech-tooltip-open", () => play("bloom"));
    sticker.addEventListener("pointerenter", (event) => {
      if (event.target === sticker && !sticker.classList.contains("is-tool-card-active")) play("whisper");
    });
  });

  const haptics = WebHaptics.isSupported ? new WebHaptics() : null;
  const assignHaptic = (selector, pattern) => {
    document.querySelectorAll(selector).forEach((element) => {
      element.dataset.haptic = pattern;
    });
  };
  assignHaptic("#profile-avatar, [data-avatar-close]", "nudge");
  assignHaptic("#theme-toggle, #copy-email, #mobile-tech-toggle, .mobile-tech-link, .experience-technology, .activity-day.t-tt-trigger, .tech-sticker", "selection");
  assignHaptic(".project-preview-cta", "success");
  assignHaptic(".social-link", "light");
  document.addEventListener("pointerdown", (event) => {
    if (!haptics || event.pointerType !== "touch" || !(event.target instanceof Element)) return;
    const target = event.target.closest("[data-haptic]");
    if (!target) return;
    void haptics.trigger(target.dataset.haptic || "light");
  }, { passive: true });

  bind();
</script>

<script is:inline>
  (() => {
    const avatar = document.getElementById("profile-avatar");
    const modal = document.getElementById("avatar-modal");
    const closeButton = modal?.querySelector(".avatar-modal-close");
    const content = modal?.querySelector(".avatar-modal-content");
    if (!avatar || !modal || !closeButton || !content) return;

    const readMs = (raw, fallback) => {
      const value = parseFloat(raw);
      if (!Number.isFinite(value)) return fallback;
      const unit = raw.trim().toLowerCase();
      if (unit.endsWith("ms")) return value;
      if (unit.endsWith("s")) return value * 1000;
      return value;
    };
    const rootStyles = getComputedStyle(document.documentElement);
    const closeMs = readMs(rootStyles.getPropertyValue("--modal-close-dur"), 150);
    const modalScale = parseFloat(rootStyles.getPropertyValue("--modal-scale")) || .96;
    let previousFocus = null;

    const setMorphOrigin = () => {
      const source = avatar.getBoundingClientRect();
      const targetWidth = content.offsetWidth || content.getBoundingClientRect().width;
      const sourceCenterX = source.left + source.width / 2;
      const sourceCenterY = source.top + source.height / 2;
      modal.style.setProperty("--avatar-origin-x", `${(sourceCenterX - window.innerWidth / 2) / modalScale}px`);
      modal.style.setProperty("--avatar-origin-y", `${(sourceCenterY - window.innerHeight / 2) / modalScale}px`);
      modal.style.setProperty("--avatar-origin-scale", String(source.width / (targetWidth * modalScale)));
    };

    const openModal = () => {
      previousFocus = document.activeElement;
      setMorphOrigin();
      modal.classList.remove("is-closing");
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.classList.add("is-avatar-modal-open");
      closeButton.focus({ preventScroll: true });
    };

    const closeModal = () => {
      if (!modal.classList.contains("is-open")) return;
      modal.classList.remove("is-open");
      modal.classList.add("is-closing");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("is-avatar-modal-open");
      window.setTimeout(() => modal.classList.remove("is-closing"), closeMs);
      if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
    };

    avatar.addEventListener("click", openModal);
    window.addEventListener("resize", () => {
      if (modal.classList.contains("is-open")) setMorphOrigin();
    });
    modal.querySelectorAll("[data-avatar-close]").forEach((button) => button.addEventListener("click", closeModal));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeModal();
    });
  })();
</script>

<script is:inline>
  (() => {
    const shell = document.querySelector(".portfolio-shell");
    const stickers = shell?.querySelectorAll(".tech-sticker");
    if (!shell || !stickers?.length) return;

    const rootStyles = getComputedStyle(document.documentElement);
    const readMs = (raw, fallback) => {
      const value = parseFloat(raw);
      if (!Number.isFinite(value)) return fallback;
      const unit = raw.trim().toLowerCase();
      if (unit.endsWith("ms")) return value;
      if (unit.endsWith("s")) return value * 1000;
      return value;
    };
    const delay = readMs(rootStyles.getPropertyValue("--tech-card-delay"), 500);
    const closeDelay = readMs(rootStyles.getPropertyValue("--tech-card-close-delay"), 180);

    stickers.forEach((sticker) => {
      let timer = 0;
      let closeTimer = 0;
      let hovering = false;
      let focused = false;
      let onCard = false;
      let dragging = false;

      const clearCloseTimer = () => {
        if (closeTimer) window.clearTimeout(closeTimer);
        closeTimer = 0;
      };

      const hide = () => {
        clearCloseTimer();
        if (timer) window.clearTimeout(timer);
        timer = 0;
        sticker.classList.remove("is-tool-card-active");
        if (!shell.querySelector(".tech-sticker.is-tool-card-active")) {
          shell.classList.remove("is-tool-card-active");
        }
      };

      const show = () => {
        clearCloseTimer();
        if (timer || sticker.classList.contains("is-tool-card-active")) return;
        timer = window.setTimeout(() => {
          timer = 0;
          sticker.classList.add("is-tool-card-active");
          shell.classList.add("is-tool-card-active");
          sticker.dispatchEvent(new CustomEvent("tech-tooltip-open"));
        }, delay);
      };

      const scheduleHide = () => {
        clearCloseTimer();
        closeTimer = window.setTimeout(() => {
          closeTimer = 0;
          if (!hovering && !focused && !onCard) hide();
        }, closeDelay);
      };

      const sync = () => {
        if (hovering || focused || onCard) show();
        else scheduleHide();
      };

      sticker.addEventListener("pointerdown", () => {
        dragging = true;
        hovering = false;
        focused = false;
        hide();
      });
      sticker.addEventListener("pointerup", () => {
        dragging = false;
        hovering = false;
        focused = false;
        hide();
      });
      sticker.addEventListener("pointercancel", () => {
        dragging = false;
        hovering = false;
        focused = false;
        hide();
      });
      sticker.addEventListener("lostpointercapture", () => {
        dragging = false;
        hovering = false;
        focused = false;
        hide();
      });
      sticker.addEventListener("pointerenter", () => { if (!dragging) { hovering = true; sync(); } });
      sticker.addEventListener("pointerleave", () => { hovering = false; sync(); });
      sticker.addEventListener("focus", () => { if (!dragging) { focused = true; sync(); } });
      sticker.addEventListener("blur", () => { focused = false; sync(); });

      const card = sticker.querySelector(".tech-tool-card");
      card?.addEventListener("pointerenter", () => { onCard = true; sync(); });
      card?.addEventListener("pointerleave", () => { onCard = false; sync(); });
    });
  })();
</script>

<script is:inline>
  (() => {
    const skeletons = document.querySelectorAll(".t-skel");
    if (!skeletons.length) return;

    const cs = getComputedStyle(document.documentElement);
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const num = (name, fallback) => {
      const value = parseFloat(cs.getPropertyValue(name));
      return Number.isFinite(value) ? value : fallback;
    };

    skeletons.forEach((skel) => {
      const skeleton = skel.querySelector(".t-skel-skeleton");
      if (!skeleton) return;

      if (reducedMotion) {
        skel.classList.add("is-revealed");
        return;
      }

      skel.classList.add("is-resetting");
      skel.classList.remove("is-revealed");
      skeleton.classList.remove("is-pulsing");
      void skeleton.offsetWidth;
      skel.classList.remove("is-resetting");
      skeleton.classList.add("is-pulsing");

      window.setTimeout(() => {
        skel.classList.add("is-revealed");
      }, num("--pulse-dur", 1000) * num("--pulse-count", 1));
    });
  })();
</script>

<script is:inline>
  (() => {
    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const maxDrag = 5;
    const maxFollow = 5;

    document.querySelectorAll(".tech-sticker").forEach((sticker) => {
      let dragging = false;
      let moved = false;
      let suppressClick = false;
      let pointerStartX = 0;
      let pointerStartY = 0;

      const reset = () => {
        dragging = false;
        sticker.classList.remove("is-peeling", "is-following");
        sticker.style.setProperty("--drag-x", "0px");
        sticker.style.setProperty("--drag-y", "0px");
      };

      sticker.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "mouse" && event.button !== 0) return;
        dragging = true;
        moved = false;
        pointerStartX = event.clientX;
        pointerStartY = event.clientY;
        sticker.classList.add("is-peeling");
        sticker.setPointerCapture?.(event.pointerId);
      });

      sticker.addEventListener("pointermove", (event) => {
        if (event.pointerType !== "mouse" && !dragging) return;
        let x;
        let y;
        if (dragging) {
          x = clamp(event.clientX - pointerStartX, -maxDrag, maxDrag);
          y = clamp(event.clientY - pointerStartY, -maxDrag, maxDrag);
          moved ||= Math.abs(event.clientX - pointerStartX) > 1 || Math.abs(event.clientY - pointerStartY) > 1;
        } else {
          const rect = sticker.getBoundingClientRect();
          x = clamp((event.clientX - (rect.left + rect.width / 2)) / (rect.width / 2) * maxFollow, -maxFollow, maxFollow);
          y = clamp((event.clientY - (rect.top + rect.height / 2)) / (rect.height / 2) * maxFollow, -maxFollow, maxFollow);
          sticker.classList.add("is-following");
        }
        sticker.style.setProperty("--drag-x", `${x}px`);
        sticker.style.setProperty("--drag-y", `${y}px`);
      });

      sticker.addEventListener("pointerleave", () => {
        if (!dragging) reset();
      });
      sticker.addEventListener("pointerup", () => {
        if (moved) suppressClick = true;
        reset();
      });
      sticker.addEventListener("pointercancel", reset);
      sticker.addEventListener("lostpointercapture", reset);
      sticker.addEventListener("click", (event) => {
        if (!suppressClick) return;
        event.preventDefault();
        suppressClick = false;
      });
    });
  })();
</script>

<script>
  import { annotate } from "rough-notation";

  const techAside = document.querySelector(".tech-stickers");
  const canAnnotate = window.matchMedia("(min-width: 1100px)").matches;
  const stickers = techAside ? Array.from(techAside.querySelectorAll(".tech-sticker")) : [];

  if (techAside && canAnnotate && stickers.length > 0) {
    const directions = {
      up: {
        path: '<path d="M40 39C38 27 29 13 19 4"/><path d="M19 4l10 1M19 4l2 10"/>',
        reserve: (bounds) => ({
          left: bounds.left - 40,
          right: bounds.right + 100,
          top: bounds.top - 16,
          bottom: bounds.bottom + 108,
        }),
      },
      down: {
        path: '<path d="M6 3C8 15 17 29 27 38"/><path d="M27 38l-10-1M27 38l-2-10"/>',
        reserve: (bounds) => ({
          left: bounds.left - 84,
          right: bounds.right + 32,
          top: bounds.top - 108,
          bottom: bounds.bottom + 16,
        }),
      },
    };
    const viewportBounds = { left: 0, right: window.innerWidth, top: 0, bottom: window.innerHeight };
    const viewportPlacements = stickers.flatMap((candidate) => {
      const bounds = candidate.getBoundingClientRect();
      return Object.entries(directions).flatMap(([direction, config]) => {
        const reserved = config.reserve(bounds);
        const withinInitialViewport = (
          reserved.left >= viewportBounds.left + 8 &&
          reserved.right <= viewportBounds.right - 8 &&
          reserved.top >= viewportBounds.top + 8 &&
          reserved.bottom <= viewportBounds.bottom - 8
        );
        return withinInitialViewport
          ? [{ candidate, direction, path: config.path }]
          : [];
      });
    });
    const selected = viewportPlacements[Math.floor(Math.random() * viewportPlacements.length)];
    const featured = selected?.candidate;
    const icon = featured?.querySelector(":scope > img");

    if (featured && icon && selected) {
      const arrow = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      arrow.setAttribute("class", `tech-hover-arrow tech-hover-arrow--${selected.direction}`);
      arrow.setAttribute("viewBox", "0 0 46 42");
      arrow.setAttribute("aria-hidden", "true");
      arrow.innerHTML = selected.path;

      const hint = document.createElement("span");
      hint.className = `tech-hover-hint tech-hover-hint--${selected.direction}`;
      hint.setAttribute("aria-hidden", "true");
      hint.textContent = techAside.dataset.hoverHint || "hover me";
      featured.append(arrow, hint);

      const getAnnotationColor = () => document.documentElement.dataset.theme === "dark"
        ? "#ffffff"
        : "#000000";
      const annotation = annotate(icon, {
        type: "circle",
        color: getAnnotationColor(),
        padding: 11,
        strokeWidth: 2.4,
        iterations: 2,
        animationDuration: 800,
      });
      window.addEventListener("itsjan-theme-change", () => {
        annotation.color = getAnnotationColor();
      });

      let dismissed = false;
      window.requestAnimationFrame(() => {
        if (!dismissed) annotation.show();
      });

      const dismiss = () => {
        if (dismissed) return;
        dismissed = true;
        arrow.classList.add("is-dismissed");
        hint.classList.add("is-dismissed");
        annotation.hide();
      };
      stickers.forEach((sticker) => {
        sticker.addEventListener("tech-tooltip-open", dismiss, { once: true });
      });
    }
  }
</script>

</Layout>
