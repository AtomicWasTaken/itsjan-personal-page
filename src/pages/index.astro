---
import Layout from "../layouts/Layout.astro";
import { detectLocale, tr } from "../lib/i18n";
import { ageYears } from "../lib/jan";
import {
  activityRevealOrder,
  buildActivity,
  createStickerLayout,
  createTechnologyCollections,
  fetchGithubContributions,
  toStickerStyle,
} from "../lib/portfolio";

const locale = detectLocale(Astro.request);
const copy = tr(locale).portfolio;
const currentAge = ageYears();
const githubDays = await fetchGithubContributions();
const technologies = createTechnologyCollections(copy.tech.items);
const activity = buildActivity(githubDays, locale, copy.activity);
const stickerLayout = createStickerLayout(copy.tech.items.length);
---

<Layout>
<div class="portfolio-shell">
  <div class="top-edge-blur" aria-hidden="true">
    <div class="top-edge-blur__wash"></div>
    <div class="top-edge-blur__layer top-edge-blur__layer--1"></div>
    <div class="top-edge-blur__layer top-edge-blur__layer--2"></div>
    <div class="top-edge-blur__layer top-edge-blur__layer--3"></div>
    <div class="top-edge-blur__layer top-edge-blur__layer--4"></div>
  </div>
  <aside class="tech-stickers" aria-label={copy.tech.aria}>
    <div class="tech-sticker-side tech-sticker-side--left">
      {copy.tech.items.map((technology, index) => {
        const placement = stickerLayout[index];
        return placement.side === "left" && (
          <a
            href={technology.href}
            target="_blank"
            rel="noreferrer"
            class={`tech-sticker tech-sticker--left tech-sticker-${index + 1}${technology.darkModeLight ? " tech-sticker--dark-logo" : ""}`}
            style={toStickerStyle(placement)}
            aria-label={technology.name}
          >
            <img src={technology.logo} alt="" width="28" height="28" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" />
          </a>
        );
      })}
    </div>
    <div class="tech-sticker-side tech-sticker-side--right">
      {copy.tech.items.map((technology, index) => {
        const placement = stickerLayout[index];
        return placement.side === "right" && (
          <a
            href={technology.href}
            target="_blank"
            rel="noreferrer"
            class={`tech-sticker tech-sticker--right tech-sticker-${index + 1}${technology.darkModeLight ? " tech-sticker--dark-logo" : ""}`}
            style={toStickerStyle(placement)}
            aria-label={technology.name}
          >
            <img src={technology.logo} alt="" width="28" height="28" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" />
          </a>
        );
      })}
    </div>
  </aside>
  <div id="avatar-modal" class="t-modal avatar-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-label={copy.avatar.expand} inert>
    <button type="button" class="avatar-modal-backdrop" data-avatar-close data-cuelume-toggle="release" aria-label={copy.avatar.collapse}></button>
    <div class="avatar-modal-content">
      <button type="button" class="squircle avatar-modal-close" data-avatar-close data-cuelume-toggle="release" aria-label={copy.avatar.collapse}>
        <span aria-hidden="true">×</span>
      </button>
      <img src="/jan-profile.jpg" alt="Jan-Marlon Leibl" width="320" height="320" class="avatar-modal-image" />
    </div>
  </div>
<main class="portfolio-main mx-auto max-w-2xl space-y-12 pt-36 pb-12 md:space-y-14 md:pb-16">
  <section>
    <div class="profile-row">
      <button
        id="profile-avatar"
        class="profile-avatar"
        type="button"
        data-cuelume-hover="whisper"
        data-cuelume-press="press"
        aria-label={copy.avatar.expand}
        aria-haspopup="dialog"
        aria-controls="avatar-modal"
      >
        <img src="/jan-profile.jpg" alt="Jan-Marlon Leibl" width="160" height="160" class="profile-image" />
      </button>
      <button
        id="theme-toggle"
        class="squircle theme-toggle"
        type="button"
        data-cuelume-toggle="toggle"
        aria-label={copy.theme.label}
        aria-pressed="false"
        data-label-dark={copy.theme.toDark}
        data-label-light={copy.theme.toLight}
      >
        <span class="theme-icon theme-icon--sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path></svg>
        </span>
        <span class="theme-icon theme-icon--moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="M20 15.2A8.3 8.3 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"></path></svg>
        </span>
      </button>
    </div>
    <h1 class="text-2xl font-medium tracking-tight">Jan-Marlon Leibl</h1>
    <p class="profile-subtitle mt-1" data-text-states={JSON.stringify(copy.subtitleStates(currentAge))}>
      <span class="t-text-swap">{copy.subtitle(currentAge)}</span>
    </p>
    <p class="mt-4 max-w-lg text-[17px] font-normal leading-7 text-[var(--text-secondary)]">
      {copy.intro.beforeBremen}<span class="keyword">Bremen</span>{copy.intro.afterBremen}<span class="keyword">{copy.intro.apprenticeship}</span>{copy.intro.afterApprenticeship}<span class="keyword">{copy.intro.finny}</span>{copy.intro.afterFinny}
    </p>
  </section>
  <hr class="wave" aria-hidden="true" />

  <section>
    <h2 class="text-2xl font-medium tracking-tight text-[var(--text)]">{copy.experience.heading}</h2>
    <ol class="experience-list mt-6">
      {copy.experience.items.map((item) => (
        <li class="experience-item">
          <p class="experience-period">{item.period}<span aria-hidden="true">, </span>{item.location}</p>
          <h3>
            {item.title}
            <span class="experience-organization">
              {item.organization}
            </span>
          </h3>
          {item.secondary && (
            <div class="experience-secondary">
              <div class="experience-role-branch border-border absolute left-2 h-7 w-4.5 rounded-bl-lg border-b-2 border-l-2" aria-hidden="true"></div>
              <p>{item.secondary.period}</p>
              <strong>{item.secondary.title}</strong>
            </div>
          )}
          <ul class="experience-bullets">
            {item.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
          <ul class="experience-technologies" aria-label={copy.tech.aria}>
            {technologies.find(item.technologies).map((technology) => (
              <li>
                <a
                  class={technology.darkModeLight ? "squircle experience-technology experience-technology--dark-logo" : "squircle experience-technology"}
                  href={technology.href}
                  target="_blank"
                  rel="noreferrer"
                  data-cuelume-hover="tick"
                  data-cuelume-press="press"
                  data-cuelume-release="release"
                >
                  <img src={technology.logo} alt="" width="16" height="16" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" />
                  <span>{technology.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>
  <hr class="wave" aria-hidden="true" />

  <section>
    <h2 class="text-2xl font-medium tracking-tight text-[var(--text)]">{copy.projects}</h2>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <article class="project-preview w-full overflow-visible">
        <div class="project-preview-surface">
          <div class="project-preview-image project-preview-image--finny" role="img" aria-label={copy.finny.previewAria}>
            <span class="preview-brand"><img src="/finny-favicon.png" alt="" width="28" height="28" />finny</span>
            <span class="preview-receipt preview-receipt--one" aria-hidden="true"><b>{copy.finny.receiptTitle}</b><i>{copy.finny.receiptVendor}</i><i>{copy.finny.receiptDetail}</i></span>
            <span class="preview-receipt preview-receipt--two" aria-hidden="true"><b>{copy.finny.warrantyTitle}</b><i>{copy.finny.warrantyDetail}</i><small>{copy.finny.warrantyUntil}</small></span>
          </div>
          <div class="project-preview-copy p-4">
            <p class="text-[15px] font-normal leading-6 text-[var(--text-secondary)]">
              {copy.finny.description.lead}<span class="keyword">{copy.finny.description.first}</span>{copy.finny.description.middle}<span class="keyword">{copy.finny.description.second}</span>{copy.finny.description.join}<span class="keyword">{copy.finny.description.third}</span>{copy.finny.description.end}
            </p>
            <div class="project-preview-action"><a href="https://fnny.app" target="_blank" rel="noreferrer" class="button-style squircle project-preview-cta" data-cuelume-hover="tick" data-cuelume-press="press" data-cuelume-release="release">{copy.finny.cta.label}</a></div>
          </div>
        </div>
      </article>

      <article class="project-preview w-full overflow-visible">
        <div class="project-preview-surface">
          <div class="project-preview-image project-preview-image--ventry" role="img" aria-label={copy.ventry.previewAria}>
            <span class="preview-brand preview-brand--ventry">
              <img class="ventry-mark" src="https://ventry.host/ventry-logo-white.png" alt="" width="28" height="28" loading="lazy" />
              ventry.host
            </span>
            <span class="ventry-file-panel" aria-hidden="true">
              <span class="ventry-file-panel-head"><b>{copy.ventry.panelTitle}</b><i>{copy.ventry.panelCount}</i></span>
              <span class="ventry-file-row">
                <span class="ventry-file-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M6 4.5h8l4 4v11H6v-15Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><path d="M14 4.5v4h4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg></span>
                <span><b>portrait.jpg</b><small>{copy.ventry.fileStatus}</small></span>
                <i>2.4 MB</i>
              </span>
              <span class="ventry-file-row ventry-file-row--muted">
                <span class="ventry-file-icon"><svg viewBox="0 0 24 24" fill="none"><path d="M8 12h8m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                <span><b>{copy.ventry.shareLabel}</b><small>{copy.ventry.shareStatus}</small></span>
                <i>{copy.ventry.shareAction}</i>
              </span>
            </span>
          </div>
          <div class="project-preview-copy p-4">
            <p class="text-[15px] font-normal leading-6 text-[var(--text-secondary)]">
              {copy.ventry.description.lead}<span class="keyword">{copy.ventry.description.keyword}</span>{copy.ventry.description.end}
            </p>
            <div class="project-preview-action"><a href="https://ventry.host" target="_blank" rel="noreferrer" class="button-style squircle project-preview-cta" data-cuelume-hover="tick" data-cuelume-press="press" data-cuelume-release="release">{copy.ventry.cta.label}</a></div>
          </div>
        </div>
      </article>

    </div>
  </section>
  <hr class="wave" aria-hidden="true" />

  <section class="mobile-tech-section">
    <h2 class="text-2xl font-medium tracking-tight text-[var(--text)]">{copy.tech.mobileHeading}</h2>
    <div id="mobile-tech-accordion" class="t-acc mobile-tech-accordion" data-open="false">
      <ul id="mobile-tech-list" class="mobile-tech-grid mt-6" aria-label={copy.tech.aria}>
        {technologies.featured.map((technology) => (
          <li>
            <a
              class={`mobile-tech-link${technology.darkModeLight ? " mobile-tech-link--dark-logo" : ""}`}
              href={technology.href}
              target="_blank"
              rel="noreferrer"
              aria-label={copy.tech.visitLabel(technology.name)}
              data-cuelume-hover="tick"
              data-cuelume-press="press"
              data-cuelume-release="release"
            >
              <img src={technology.logo} alt="" width="28" height="28" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" />
              <span>{technology.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <div id="mobile-tech-additional" class="t-acc-panel">
        <div class="t-acc-panel-inner">
          <ul class="mobile-tech-grid" aria-label={copy.tech.aria}>
            {technologies.additional.map((technology) => (
              <li>
                <a
                  class={`mobile-tech-link${technology.darkModeLight ? " mobile-tech-link--dark-logo" : ""}`}
                  href={technology.href}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={copy.tech.visitLabel(technology.name)}
                  data-cuelume-hover="tick"
                  data-cuelume-press="press"
                  data-cuelume-release="release"
                >
                  <img src={technology.logo} alt="" width="28" height="28" loading="lazy" decoding="async" referrerpolicy="no-referrer" draggable="false" />
                  <span>{technology.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <button
        id="mobile-tech-toggle"
        class="button-style squircle t-acc-head mobile-tech-toggle"
        type="button"
        aria-controls="mobile-tech-additional"
        aria-expanded="false"
        data-label-more={copy.tech.mobileViewMore}
        data-label-less={copy.tech.mobileViewLess}
        data-cuelume-hover="tick"
        data-cuelume-press="press"
        data-cuelume-release="release"
      >
        <span class="mobile-tech-toggle-label">{copy.tech.mobileViewMore}</span>
        <span class="t-acc-chevron" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none"><path d="M4 6.5L8 10.5L12 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
      </button>
    </div>
  </section>
  <hr class="wave wave--mobile" aria-hidden="true" />

  <section>
    <h2 class="text-2xl font-medium tracking-tight text-[var(--text)]">{copy.activity.heading}</h2>
    <div class="mt-6">
      <div class="activity-scroll activity-scroll-desktop" role="group" aria-label={copy.activity.desktopAria}>
        <div class="t-skel activity-reveal" data-state="loading">
          <div class="t-skel-skeleton is-pulsing activity-grid" aria-hidden="true">
            {activity.map((_, index) => <span class="activity-day" data-level="0" style={`--activity-order:${activityRevealOrder(index)}`}></span>)}
          </div>
          <div class="t-skel-content activity-grid">
            {activity.map((day, index) => (
              day.count > 0 ? (
                <span class="t-tt-wrap activity-tooltip-wrap">
                  <span class="activity-day t-tt-trigger" data-cuelume-hover="tick" data-level={day.level} data-project={day.project} role="img" aria-label={day.label} aria-describedby={`activity-tooltip-desktop-${index}`} tabindex="0" style={`--activity-order:${activityRevealOrder(index)}`}></span>
                  <span id={`activity-tooltip-desktop-${index}`} class="t-tt activity-tooltip" role="tooltip">{day.label}</span>
                </span>
              ) : (
                <span class="activity-day" data-level={day.level} data-project={day.project} role="img" aria-label={day.label} style={`--activity-order:${activityRevealOrder(index)}`}></span>
              )
            ))}
          </div>
        </div>
      </div>
      <div class="activity-scroll activity-scroll-mobile" role="group" aria-label={copy.activity.mobileAria}>
        <div class="t-skel activity-reveal activity-reveal-mobile" data-state="loading">
          <div class="t-skel-skeleton is-pulsing activity-grid activity-grid-mobile" aria-hidden="true">
            {activity.map((_, index) => <span class="activity-day" data-level="0" style={`--activity-order:${activityRevealOrder(index)}`}></span>)}
          </div>
          <div class="t-skel-content activity-grid activity-grid-mobile">
            {activity.map((day, index) => (
              day.count > 0 ? (
                <span class="t-tt-wrap activity-tooltip-wrap">
                  <span class="activity-day t-tt-trigger" data-cuelume-hover="tick" data-level={day.level} data-project={day.project} role="img" aria-label={day.label} aria-describedby={`activity-tooltip-mobile-${index}`} tabindex="0" style={`--activity-order:${activityRevealOrder(index)}`}></span>
                  <span id={`activity-tooltip-mobile-${index}`} class="t-tt activity-tooltip" role="tooltip">{day.label}</span>
                </span>
              ) : (
                <span class="activity-day" data-level={day.level} data-project={day.project} role="img" aria-label={day.label} style={`--activity-order:${activityRevealOrder(index)}`}></span>
              )
            ))}
          </div>
        </div>
      </div>
      <div class="activity-legend" aria-hidden="true"><span>{copy.activity.less}</span><i data-level="0"></i><i data-level="1"></i><i data-level="2"></i><i data-level="3"></i><i data-level="4"></i><span>{copy.activity.more}</span></div>
    </div>
  </section>
  <hr class="wave" aria-hidden="true" />

  <section>
    <h2 class="text-2xl font-medium tracking-tight text-[var(--text)]">{copy.connect.heading}</h2>
    <div class="connect-row mt-6">
      <div class="social-links flex items-center text-[var(--text-tertiary)]">
        <a href="https://x.com/janodersooo" target="_blank" rel="noreferrer" aria-label={copy.connect.xAria} class="social-link"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg></a>
        <a href="https://github.com/AtomicWasTaken" target="_blank" rel="noreferrer" aria-label={copy.connect.githubAria} class="social-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg></a>
        <a href="https://www.linkedin.com/in/janmarlonleibl/" target="_blank" rel="noreferrer" aria-label={copy.connect.linkedinAria} class="social-link"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 4.5A1.5 1.5 0 1 1 2 4.5a1.5 1.5 0 0 1 3 0ZM2.5 8.5h3V21h-3V8.5ZM9 8.5h2.9v1.7h.1c.4-.8 1.5-2.1 3.6-2.1 3.9 0 4.6 2.6 4.6 6V21h-3v-6.1c0-1.5 0-3.5-2.1-3.5s-2.4 1.7-2.4 3.4V21H9V8.5Z"></path></svg></a>
        <a href="mailto:hi@itsjan.dev" aria-label={copy.connect.emailAria} class="social-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="3"></rect><path d="m3 6 9 6 9-6"></path></svg></a>
      </div>
      <button
        id="copy-email"
        class="button-style squircle copy-email-button"
        type="button"
        data-email="hi@itsjan.dev"
        data-label-copy={copy.connect.copyEmail}
        data-label-copied={copy.connect.emailCopied}
        aria-label={copy.connect.copyEmail}
        data-cuelume-hover="tick"
        data-cuelume-press="press"
        data-cuelume-release="release"
      >
        <span class="copy-email-icon copy-email-icon--copy" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg></span>
        <span class="copy-email-icon copy-email-icon--check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4 4L19 6"></path></svg></span>
        <span class="copy-email-label-slot">
          <span class="copy-email-label t-text-swap" aria-live="polite">{copy.connect.copyEmail}</span>
          <span class="copy-email-label-measure" aria-hidden="true">{copy.connect.copyEmail}</span>
          <span class="copy-email-label-measure" aria-hidden="true">{copy.connect.emailCopied}</span>
        </span>
      </button>
    </div>
  </section>
</main>
<script is:inline>
  (() => {
    const accordion = document.getElementById("mobile-tech-accordion");
    const toggle = document.getElementById("mobile-tech-toggle");
    const label = toggle?.querySelector(".mobile-tech-toggle-label");
    if (!accordion || !toggle || !label) return;

    toggle.addEventListener("click", () => {
      const open = accordion.getAttribute("data-open") === "true";
      const nextOpen = !open;
      accordion.setAttribute("data-open", String(nextOpen));
      toggle.setAttribute("aria-expanded", String(nextOpen));
      label.textContent = nextOpen
        ? (toggle.dataset.labelLess || "Show less")
        : (toggle.dataset.labelMore || "View more");
    });
  })();
</script>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const toggle = document.getElementById("theme-toggle");
    if (!toggle) return;

    const storageKey = "itsjan-theme";
    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
    const themeColor = document.getElementById("theme-color");
    let activeTransition = null;

    const applyTheme = (theme) => {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
      toggle.setAttribute("aria-pressed", String(theme === "dark"));
      toggle.setAttribute("aria-label", theme === "dark" ? toggle.dataset.labelLight : toggle.dataset.labelDark);
      themeColor?.setAttribute("content", theme === "dark" ? "#0b0b0c" : "#ffffff");
    };

    const transitionTheme = (theme) => {
      if (activeTransition) return;
      const bounds = toggle.getBoundingClientRect();
      const x = bounds.left + bounds.width / 2;
      const y = bounds.top + bounds.height / 2;
      const radius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );
      root.style.setProperty("--theme-ripple-x", `${x}px`);
      root.style.setProperty("--theme-ripple-y", `${y}px`);
      root.style.setProperty("--theme-ripple-radius", `${radius}px`);
      root.classList.add("is-theme-changing");

      const clearTransition = () => {
        root.classList.remove("is-theme-changing");
        root.style.removeProperty("--theme-ripple-x");
        root.style.removeProperty("--theme-ripple-y");
        root.style.removeProperty("--theme-ripple-radius");
        activeTransition = null;
      };

      if (typeof document.startViewTransition !== "function") {
        applyTheme(theme);
        window.requestAnimationFrame(() => window.requestAnimationFrame(clearTransition));
        return;
      }

      try {
        const transition = document.startViewTransition(() => applyTheme(theme));
        activeTransition = transition;
        transition.finished.then(clearTransition, clearTransition);
      } catch {
        applyTheme(theme);
        clearTransition();
      }
    };

    toggle.addEventListener("click", () => {
      if (activeTransition) return;
      const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
      try { window.localStorage.setItem(storageKey, nextTheme); } catch {}
      transitionTheme(nextTheme);
    });

    systemTheme.addEventListener?.("change", (event) => {
      let stored = null;
      try { stored = window.localStorage.getItem(storageKey); } catch {}
      if (!stored) applyTheme(event.matches ? "dark" : "light");
    });

    applyTheme(root.dataset.theme === "dark" ? "dark" : "light");
  })();
</script>

<script is:inline>
  (() => {
    const subtitle = document.querySelector(".profile-subtitle");
    const label = subtitle?.querySelector(".t-text-swap");
    if (!subtitle || !label || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let states = [];
    try { states = JSON.parse(subtitle.dataset.textStates || "[]"); } catch {}
    if (states.length < 2) return;

    let index = 0;
    let swapTimer = 0;
    let isSwapping = false;
    const readMs = (name, fallback) => {
      const raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      const value = parseFloat(raw);
      return Number.isFinite(value) ? value : fallback;
    };
    const swapText = (nextText) => {
      if (isSwapping) return;
      isSwapping = true;
      label.classList.add("is-exit");
      window.clearTimeout(swapTimer);
      swapTimer = window.setTimeout(() => {
        label.textContent = nextText;
        label.classList.remove("is-exit");
        label.classList.add("is-enter-start");
        void label.offsetHeight;
        label.classList.remove("is-enter-start");
        isSwapping = false;
      }, readMs("--text-swap-dur", 150));
    };

    window.setInterval(() => {
      if (document.hidden) return;
      index = (index + 1) % states.length;
      swapText(states[index]);
    }, 3600);
  })();
</script>

<script is:inline>
  (() => {
    const button = document.getElementById("copy-email");
    if (!button) return;

    const label = button.querySelector(".copy-email-label");
    const email = button.dataset.email;
    let resetTimer = 0;
    let swapTimer = 0;
    let isSwapping = false;

    const readMs = (name, fallback) => {
      const raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      const value = parseFloat(raw);
      return Number.isFinite(value) ? value : fallback;
    };

    const swapText = (nextText) => {
      if (!label || isSwapping || label.textContent === nextText) return;
      isSwapping = true;
      label.classList.add("is-exit");
      window.clearTimeout(swapTimer);
      swapTimer = window.setTimeout(() => {
        label.textContent = nextText;
        label.classList.remove("is-exit");
        label.classList.add("is-enter-start");
        void label.offsetHeight;
        label.classList.remove("is-enter-start");
        isSwapping = false;
      }, readMs("--text-swap-dur", 150));
    };

    button.addEventListener("click", async () => {
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        button.dataset.copied = "true";
        button.setAttribute("aria-label", button.dataset.labelCopied || "Email copied");
        swapText(button.dataset.labelCopied || "Email copied");
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute("aria-label", button.dataset.labelCopy || "Copy email");
          swapText(button.dataset.labelCopy || "Copy email");
        }, 3000);
      } catch {
        window.location.assign(`mailto:${email}`);
      }
    });
  })();
</script>

<script>
  import { bind, play } from "cuelume";
  import { WebHaptics } from "web-haptics";

  document.querySelectorAll(".social-link").forEach((link) => {
    link.dataset.cuelumeHover = "tick";
    link.dataset.cuelumePress = "press";
    link.dataset.cuelumeRelease = "release";
  });
  document.querySelectorAll(".tech-sticker").forEach((sticker) => {
    sticker.dataset.cuelumePress = "press";
    sticker.dataset.cuelumeRelease = "release";
    sticker.addEventListener("pointerenter", (event) => {
      if (event.target === sticker) play("whisper");
    });
  });

  const haptics = WebHaptics.isSupported ? new WebHaptics() : null;
  const assignHaptic = (selector, pattern) => {
    document.querySelectorAll(selector).forEach((element) => {
      element.dataset.haptic = pattern;
    });
  };
  assignHaptic("#profile-avatar, [data-avatar-close]", "nudge");
  assignHaptic("#theme-toggle, #copy-email, #mobile-tech-toggle, .mobile-tech-link, .experience-technology, .activity-day.t-tt-trigger, .tech-sticker", "selection");
  assignHaptic(".project-preview-cta", "success");
  assignHaptic(".social-link", "light");
  document.addEventListener("pointerdown", (event) => {
    if (!haptics || event.pointerType !== "touch" || !(event.target instanceof Element)) return;
    const target = event.target.closest("[data-haptic]");
    if (!target) return;
    void haptics.trigger(target.dataset.haptic || "light");
  }, { passive: true });

  bind();
</script>

<script is:inline>
  (() => {
    const avatar = document.getElementById("profile-avatar");
    const modal = document.getElementById("avatar-modal");
    const closeButton = modal?.querySelector(".avatar-modal-close");
    const content = modal?.querySelector(".avatar-modal-content");
    if (!avatar || !modal || !closeButton || !content) return;

    const readMs = (raw, fallback) => {
      const value = parseFloat(raw);
      if (!Number.isFinite(value)) return fallback;
      const unit = raw.trim().toLowerCase();
      if (unit.endsWith("ms")) return value;
      if (unit.endsWith("s")) return value * 1000;
      return value;
    };
    const rootStyles = getComputedStyle(document.documentElement);
    const closeMs = readMs(rootStyles.getPropertyValue("--modal-close-dur"), 150);
    const modalScale = parseFloat(rootStyles.getPropertyValue("--modal-scale")) || .96;
    let previousFocus = null;

    const setMorphOrigin = () => {
      const source = avatar.getBoundingClientRect();
      const targetWidth = content.offsetWidth || content.getBoundingClientRect().width;
      const sourceCenterX = source.left + source.width / 2;
      const sourceCenterY = source.top + source.height / 2;
      modal.style.setProperty("--avatar-origin-x", `${(sourceCenterX - window.innerWidth / 2) / modalScale}px`);
      modal.style.setProperty("--avatar-origin-y", `${(sourceCenterY - window.innerHeight / 2) / modalScale}px`);
      modal.style.setProperty("--avatar-origin-scale", String(source.width / (targetWidth * modalScale)));
    };

    const openModal = () => {
      previousFocus = document.activeElement;
      setMorphOrigin();
      modal.removeAttribute("inert");
      modal.classList.remove("is-closing");
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.classList.add("is-avatar-modal-open");
      closeButton.focus({ preventScroll: true });
    };

    const closeModal = () => {
      if (!modal.classList.contains("is-open")) return;
      modal.classList.remove("is-open");
      modal.classList.add("is-closing");
      modal.setAttribute("inert", "");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("is-avatar-modal-open");
      window.setTimeout(() => modal.classList.remove("is-closing"), closeMs);
      if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
    };

    avatar.addEventListener("click", openModal);
    window.addEventListener("resize", () => {
      if (modal.classList.contains("is-open")) setMorphOrigin();
    });
    modal.querySelectorAll("[data-avatar-close]").forEach((button) => button.addEventListener("click", closeModal));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeModal();
    });
  })();
</script>

<script is:inline>
  (() => {
    const skeletons = document.querySelectorAll(".t-skel");
    if (!skeletons.length) return;

    const cs = getComputedStyle(document.documentElement);
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const num = (name, fallback) => {
      const value = parseFloat(cs.getPropertyValue(name));
      return Number.isFinite(value) ? value : fallback;
    };

    skeletons.forEach((skel) => {
      const skeleton = skel.querySelector(".t-skel-skeleton");
      if (!skeleton) return;

      if (reducedMotion) {
        skel.classList.add("is-revealed");
        return;
      }

      skel.classList.add("is-resetting");
      skel.classList.remove("is-revealed");
      skeleton.classList.remove("is-pulsing");
      void skeleton.offsetWidth;
      skel.classList.remove("is-resetting");
      skeleton.classList.add("is-pulsing");

      window.setTimeout(() => {
        skel.classList.add("is-revealed");
      }, num("--pulse-dur", 1000) * num("--pulse-count", 1));
    });
  })();
</script>

<script is:inline>
  (() => {
    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const maxDrag = 5;
    const maxFollow = 5;

    document.querySelectorAll(".tech-sticker").forEach((sticker) => {
      let dragging = false;
      let moved = false;
      let suppressClick = false;
      let pointerStartX = 0;
      let pointerStartY = 0;

      const reset = () => {
        dragging = false;
        sticker.classList.remove("is-peeling", "is-following");
        sticker.style.setProperty("--drag-x", "0px");
        sticker.style.setProperty("--drag-y", "0px");
      };

      sticker.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "mouse" && event.button !== 0) return;
        dragging = true;
        moved = false;
        pointerStartX = event.clientX;
        pointerStartY = event.clientY;
        sticker.classList.add("is-peeling");
        sticker.setPointerCapture?.(event.pointerId);
      });

      sticker.addEventListener("pointermove", (event) => {
        if (event.pointerType !== "mouse" && !dragging) return;
        let x;
        let y;
        if (dragging) {
          x = clamp(event.clientX - pointerStartX, -maxDrag, maxDrag);
          y = clamp(event.clientY - pointerStartY, -maxDrag, maxDrag);
          moved ||= Math.abs(event.clientX - pointerStartX) > 1 || Math.abs(event.clientY - pointerStartY) > 1;
        } else {
          const rect = sticker.getBoundingClientRect();
          x = clamp((event.clientX - (rect.left + rect.width / 2)) / (rect.width / 2) * maxFollow, -maxFollow, maxFollow);
          y = clamp((event.clientY - (rect.top + rect.height / 2)) / (rect.height / 2) * maxFollow, -maxFollow, maxFollow);
          sticker.classList.add("is-following");
        }
        sticker.style.setProperty("--drag-x", `${x}px`);
        sticker.style.setProperty("--drag-y", `${y}px`);
      });

      sticker.addEventListener("pointerleave", () => {
        if (!dragging) reset();
      });
      sticker.addEventListener("pointerup", () => {
        if (moved) suppressClick = true;
        reset();
      });
      sticker.addEventListener("pointercancel", reset);
      sticker.addEventListener("lostpointercapture", reset);
      sticker.addEventListener("click", (event) => {
        if (!suppressClick) return;
        event.preventDefault();
        suppressClick = false;
      });
    });
  })();
</script>

</Layout>
