    });

    // Project CTA buttons (Finny, Ventry)
    document.querySelectorAll('.project-preview-cta').forEach((el) => {
      el.addEventListener('click', () => {
        const href = el instanceof HTMLAnchorElement ? el.href : '';
        let project_name = 'unknown';
        if (href.includes('fnny.app')) project_name = 'finny';
        else if (href.includes('ventry.host')) project_name = 'ventry';
        if (typeof window.posthog?.capture === 'function') {
          window.posthog.capture('project_cta_clicked', { project_name });
        }
      });
    });

    // Social platform links
    document.querySelectorAll('.social-link').forEach((el) => {
      el.addEventListener('click', () => {
        const href = el instanceof HTMLAnchorElement ? el.href : '';
        let platform = 'unknown';
        if (href.includes('github.com')) platform = 'github';
        else if (href.includes('x.com') || href.includes('twitter.com')) platform = 'x';
        else if (href.includes('linkedin.com')) platform = 'linkedin';
        else if (href.startsWith('mailto:')) platform = 'email';
        else if (el.id === 'share-profile') platform = 'share';
        if (typeof window.posthog?.capture === 'function') {
          window.posthog.capture('social_link_clicked', { platform });
        }
      });
    });
  })();
</script>

</Layout>
