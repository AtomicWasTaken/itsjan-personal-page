---
import Layout from "../layouts/Layout.astro";
import EdgeBlur from "../components/EdgeBlur.astro";
import InteractiveLink from "../components/InteractiveLink.astro";
import ArrowIcon from "../components/icons/ArrowIcon.astro";
import type { Locale } from "../lib/locale";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "en";
const de = locale === "de";
const title = de
  ? "Datenschutzerklärung · Jan-Marlon Leibl"
  : "Privacy policy · Jan-Marlon Leibl";
const description = de
  ? "Wie itsjan.dev mit personenbezogenen Daten umgeht."
  : "How itsjan.dev handles personal data.";
---

<Layout
  title={title}
  description={description}
  markdownPath={`/privacy.${locale}.md`}
  alternatePaths={{
    en: "/en/privacy",
    de: "/de/datenschutz",
    "x-default": "/en/privacy",
  }}
>
  <div class="privacy-shell">
    <EdgeBlur />
    <EdgeBlur edge="bottom" />
    <main class="privacy-main">
      <InteractiveLink
        variant="text"
        class="hero-project-link privacy-back"
        href={de ? "/de" : "/en"}
      >
        <ArrowIcon direction="left" />
        <span>{de ? "Zurück zur Startseite" : "Back home"}</span>
      </InteractiveLink>
      {
        de ? (
          <>
            <h1>Datenschutzerklärung</h1>
            <p class="privacy-updated">Stand: 12. August 2026</p>
            <section>
              <h2>Verantwortlicher</h2>
              <p>Jan-Marlon Leibl, Bremen, Deutschland</p>
              <InteractiveLink
                variant="text"
                class="privacy-action-link"
                href="mailto:hi@itsjan.dev"
              >
                hi@itsjan.dev <ArrowIcon />
              </InteractiveLink>
            </section>
            <section>
              <h2>Hosting</h2>
              <p>
                Cloudflare liefert diese Website aus. Dafür verarbeitet der
                Dienst technisch notwendige Verbindungsdaten wie Ihre
                IP-Adresse, den Zeitpunkt des Aufrufs und die angeforderten
                Inhalte.
              </p>
              <InteractiveLink
                variant="text"
                class="privacy-action-link"
                href="https://www.cloudflare.com/privacypolicy/"
                target="_blank"
                rel="noreferrer"
              >
                Cloudflare-Datenschutzerklärung{" "}
                <ArrowIcon direction="external" />
              </InteractiveLink>
            </section>
            <section>
              <h2>Reichweitenmessung mit PostHog</h2>
              <p>
                Ich lade PostHog (PostHog, Inc.) mit EU-Datenstandort nur, wenn
                Sie ausdrücklich zustimmen. Das Tool zeigt mir, welche Seiten
                und Funktionen genutzt werden, und hilft bei der Suche nach
                technischen Fehlern. Dabei kann PostHog aufgerufene Seiten,
                Interaktionen, Browser- und Geräteinformationen sowie eine
                pseudonyme Kennung verarbeiten.
              </p>
              <p>
                Rechtsgrundlage ist Ihre Einwilligung gemäß Art. 6 Abs. 1 lit. a
                DSGVO sowie § 25 Abs. 1 TDDDG. Sie entscheiden freiwillig und
                können Ihre Einwilligung jederzeit über die
                Datenschutz-Einstellungen widerrufen. Ohne Ihre Zustimmung
                startet PostHog nicht und setzt keine Analyse-Cookies.
              </p>
              <div class="privacy-link-list">
                <InteractiveLink
                  variant="text"
                  class="privacy-action-link"
                  href="https://posthog.com/privacy"
                  target="_blank"
                  rel="noreferrer"
                >
                  PostHog Datenschutzhinweise <ArrowIcon direction="external" />
                </InteractiveLink>
                <InteractiveLink
                  variant="text"
                  class="privacy-action-link"
                  href="https://posthog.com/dpa"
                  target="_blank"
                  rel="noreferrer"
                >
                  PostHog Auftragsverarbeitungsvereinbarung{" "}
                  <ArrowIcon direction="external" />
                </InteractiveLink>
              </div>
            </section>
            <section>
              <h2>Fehlerdiagnose</h2>
              <p>
                Wenn Sie zugestimmt haben, kann PostHog technische Fehler und
                nicht behandelte JavaScript-Ausnahmen erhalten. Formulareingaben
                und Inhalte aus der Konsole erfasse ich nicht absichtlich.
                Sitzungsaufzeichnungen (Session Replay) sind auf dieser Website
                ausgeschaltet.
              </p>
            </section>
            <section>
              <h2>Ihre Rechte</h2>
              <p>
                Soweit die gesetzlichen Voraussetzungen vorliegen, haben Sie das
                Recht auf Auskunft, Berichtigung, Löschung, Einschränkung der
                Verarbeitung, Datenübertragbarkeit und Widerspruch. Sie können
                sich außerdem bei einer Datenschutzaufsichtsbehörde beschweren.
                Für eine Anfrage reicht eine E-Mail an die oben genannte
                Adresse.
              </p>
            </section>
          </>
        ) : (
          <>
            <h1>Privacy policy</h1>
            <p class="privacy-updated">Last updated: 12 August 2026</p>
            <section>
              <h2>Controller</h2>
              <p>Jan-Marlon Leibl, Bremen, Germany</p>
              <InteractiveLink
                variant="text"
                class="privacy-action-link"
                href="mailto:hi@itsjan.dev"
              >
                hi@itsjan.dev <ArrowIcon />
              </InteractiveLink>
            </section>
            <section>
              <h2>Hosting</h2>
              <p>
                Cloudflare delivers this website. To do that, the service
                processes necessary connection data such as your IP address, the
                time of the request and the requested content.
              </p>
              <InteractiveLink
                variant="text"
                class="privacy-action-link"
                href="https://www.cloudflare.com/privacypolicy/"
                target="_blank"
                rel="noreferrer"
              >
                Cloudflare Privacy Policy <ArrowIcon direction="external" />
              </InteractiveLink>
            </section>
            <section>
              <h2>Analytics with PostHog</h2>
              <p>
                I load PostHog (PostHog, Inc.) with EU data hosting only after
                you explicitly agree. It shows me which pages and features
                people use and helps me find technical errors. PostHog may
                process visited pages, interactions, browser and device
                information, and a pseudonymous identifier.
              </p>
              <p>
                The legal basis is your consent. The choice is voluntary, and
                you can withdraw it at any time in the privacy settings. Without
                your consent, PostHog does not start or set analytics cookies.
              </p>
              <div class="privacy-link-list">
                <InteractiveLink
                  variant="text"
                  class="privacy-action-link"
                  href="https://posthog.com/privacy"
                  target="_blank"
                  rel="noreferrer"
                >
                  PostHog Privacy notice <ArrowIcon direction="external" />
                </InteractiveLink>
                <InteractiveLink
                  variant="text"
                  class="privacy-action-link"
                  href="https://posthog.com/dpa"
                  target="_blank"
                  rel="noreferrer"
                >
                  PostHog Data Processing Agreement{" "}
                  <ArrowIcon direction="external" />
                </InteractiveLink>
              </div>
            </section>
            <section>
              <h2>Error diagnostics</h2>
              <p>
                After you consent, PostHog may receive technical errors and
                unhandled JavaScript exceptions. I do not intentionally capture
                form input or console output. Session Replay is turned off on
                this site.
              </p>
            </section>
            <section>
              <h2>Your rights</h2>
              <p>
                Where the law applies, you may request access, correction,
                deletion, restriction or transfer of your personal data, or
                object to its processing. You can also complain to a data
                protection authority. Send requests to the email address above.
              </p>
            </section>
          </>
        )
      }
    </main>
  </div>
</Layout>
